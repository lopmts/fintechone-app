generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id
  name          String?
  imageUrl      String?
  email         String       @unique
  codeuniq      String       @unique
  password      String?
  provider      AuthProvider @default(LOCAL)
  googleId      String?      @unique
  emailVerified Boolean      @default(false)

  currency String  @default("BRL")
  isActive Boolean @default(true)

  syncVersion Int @default(1)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  budgets           Budget[]
  transactions      Transaction[]
  financings        Financing[]
  verificationCodes VerificationCode[]
  deleteRequests    DeleteRequest[]
  pushTokens        PushToken[]
  syncLogs          SyncLog[]
  sessions          Session[]

  @@index([email])
  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Account {
  id     String @id
  userId String

  name String
  type AccountType @default(CHECKING)
  bank BankType    @default(OTHER)

  initialBalance Decimal @db.Decimal(12, 2)

  color       String?
  icon        String?
  syncVersion Int       @default(1)
  salary      Decimal?  @db.Decimal(12, 2)
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

model DeleteRequest {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("delete_requests")
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_codes")
}

model Category {
  id String @id

  key CategoryKey @unique

  name        String
  icon        String
  color       String
  type        TransactionType
  syncVersion Int             @default(1)
  deletedAt   DateTime?

  transactions Transaction[]

  budgets Budget[]

  @@map("categories")
}

model Transaction {
  id          String          @id
  userId      String
  accountId   String
  categoryId  String?
  description String
  notes       String?
  receiptUrl  String?
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType

  date DateTime

  isRecurring Boolean @default(false)

  installments Int?

  parentTransactionId String?

  syncVersion Int @default(1)

  deletedAt DateTime?

  lastDeviceId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([date])
  @@map("transactions")
}

model Budget {
  id String @id

  userId String

  categoryId String?

  name String

  amount Decimal @db.Decimal(12, 2)

  period BudgetPeriod

  startDate DateTime

  endDate DateTime

  isActive Boolean @default(true)

  syncVersion Int @default(1)

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@map("budgets")
}

model Financing {
  id       String  @id @default(cuid())
  userId   String
  isActive Boolean @default(true)
  title    String?

  amount            Decimal  @db.Decimal(12, 2) // valor financiado (informativo)
  installmentAmount Decimal  @db.Decimal(12, 2) // valor da parcela, informado pelo usuário
  interestRate      Decimal? @db.Decimal(5, 2) // % ao mês — opcional, apenas informativo
  installments      Int
  startDate         DateTime

  // ── Penalidades por atraso (percentuais sobre o valor da parcela) ──
  lateFeeRate      Decimal? @db.Decimal(5, 2) // multa única, % sobre a parcela
  lateInterestRate Decimal? @db.Decimal(5, 2) // juros de mora, % ao dia sobre a parcela

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  installmentsPaid InstallmentsPaid[]

  @@map("financing")
}

model InstallmentsPaid {
  id                String   @id @default(cuid())
  financingId       String
  installmentNumber Int
  amount            Decimal  @db.Decimal(12, 2)
  paidAt            DateTime @default(now())
  createdAt         DateTime @default(now())

  financing Financing @relation(fields: [financingId], references: [id], onDelete: Cascade)

  @@unique([financingId, installmentNumber])
  @@map("installments_paid")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_token")
}

model SyncLog {
  id String @id

  userId String

  deviceId String

  lastSyncAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("sync_logs")
}

enum CategoryKey {
  FOOD
  TRANSPORT
  HOUSING
  HEALTH
  LEISURE
  EDUCATION
  CLOTHING
  SALARY
  FREELANCE
  INVESTMENT
  CARD
  OTHER
}

enum BankType {
  NUBANK
  ITAÚ
  BRADESCO
  SANTANDER
  CAIXA
  BANCO_DO_BRASIL
  INTER
  C6_BANK
  PAGBANK
  NEXT
  ORIGINAL

  OTHER
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT
  MAIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}
